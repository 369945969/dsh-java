# 复制为 .env 并填入真实值（.env 不会被提交到 GitHub）。
# 模型用 OpenAI 兼容端点初始化；以下为阿里云 DashScope 的 glm-5.2 示例。

# 模型 API Key（必填）。对应 opencode 中 aliyuncs/glm-5.2 的 apiKey。
DEEPSEEK_API_KEY=sk-your-dashscope-key-here

# OpenAI 兼容端点（DashScope）。
DSH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（opencode 中 aliyuncs/glm-5.2 的 id）。
DSH_MODEL=glm-5.2
