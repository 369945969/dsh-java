<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.deepseek.dsh</groupId>
        <artifactId>dsh-parent</artifactId>
        <version>0.1.1-rc.2-java</version>
    </parent>
    <artifactId>testcase</artifactId>
    <name>RPC 集成测试（基于 dsh SDK）</name>
    <description>用 dsh SDK 客户端进程内驱动 DshRpcServer，验证后端 RPC 提供的全部功能。
        使用环境变量 DEEPSEEK_API_KEY/DSH_BASE_URL/DSH_MODEL 配置的真实模型（如阿里云 glm-5.2）；
        无 key 时整套测试通过 assumeTrue 跳过，不影响常规构建。</description>
    <dependencies>
        <dependency>
            <groupId>com.deepseek.dsh</groupId>
            <artifactId>dsh-app</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deepseek.dsh</groupId>
            <artifactId>dsh-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <mainClass>com.deepseek.dsh.testcase.RpcE2e</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
