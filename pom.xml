<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.deepseek.dsh</groupId>
    <artifactId>dsh-parent</artifactId>
    <version>0.1.1-rc.2-java</version>
    <packaging>pom</packaging>

    <name>DeepSeek Harness (Java Rewrite)</name>
    <description>
        A Java reimplementation of DeepSeek Harness (dsh) — an open-source agent harness.
        Backend in Java 21 + Spring Boot 3, plugin-first architecture (Cordis-equivalent context),
        borrowing architectural concepts from AgentScope (ReAct loop, Toolkit, Middleware, Event Bus,
        Permission/HITL). Original React frontend style preserved.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.4</spring-boot.version>
        <jackson.version>2.17.2</jackson.version>
        <jackson-jsr310.version>2.17.2</jackson-jsr310.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>5.11.0</junit.version>
        <mockito.version>5.12.0</mockito.version>
        <reactor.version>3.6.9</reactor.version>
        <okhttp.version>4.12.0</okhttp.version>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
    </properties>

    <modules>
