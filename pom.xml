        <module>dsh-capability-web</module>
        <module>dsh-sandbox</module>
        <module>dsh-jobs</module>
        <module>dsh-todo</module>
        <module>dsh-guard</module>
        <module>dsh-context</module>
        <module>dsh-credentials</module>
        <module>dsh-settings</module>
        <module>dsh-storage</module>
        <module>dsh-spill</module>
